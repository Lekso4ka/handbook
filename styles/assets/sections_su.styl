@import "./variables.styl"

.suprematism
    section
        margin-bottom 2rem
    .section_0_1
        display block
        padding 20vh 0
        height 100vh
        box-sizing border-box
        h1
            font-family "Rodchenko Constructed", serif
            font-size 10vw
            color su-secondary
            margin-bottom 2rem
        h2
            font-family "Rodchenko Grotesk"
            color su-primary
            text-align right
            font-size 6vw
            letter-spacing initial
            width 100%
            justify-content flex-end
            &::before
                display none
        @media screen and (min-width: 576px)
            h1
                font-size 4rem
            h2
                font-size 2rem
        @media screen and (min-width: 1200px)
            grid-column-end span 3
            h1
                font-size 8rem
                margin-bottom 6rem
            h2
                font-size 3rem
                margin-left 40%
                width 60%

    .section_0_2
        padding-top 1rem
        width 100%
        h2
            column-span all
        p
            column-count 2
            column-gap 1.5rem
        .custom_pic
            width 100%
            height 400px
            background-image url("./img/suprematism/pic1.png")
            background-size contain
            background-repeat no-repeat
            background-position center
            margin 1rem 0
        .custom_btn
            width 100%
            justify-content center
        @media screen and (min-width: 1200px)
            display grid
            grid-column-end span 3
            grid-template-columns repeat(2, 1fr) auto
            gap 1rem 2rem
            p
                column-count 1
                margin-bottom 0
            h2
                grid-column-end span 2
            :nth-child(2)
                grid-column-start 1
                grid-row-start 2
            :nth-child(4)
                grid-row-start 2
                //grid-row-end 3
                grid-column-start 2
            .custom_btn
                grid-row-start 1
                grid-column-start 3
                width max-content
                justify-self flex-end
            .custom_pic
                margin 0
                height auto
                background-position top right
    .section_0_3
        padding-top 1rem
        display grid
        gap 1rem 2rem
        position relative
        article
            margin-bottom 1rem
        .custom_btn
            width 100%
            justify-content center
        h3
            background-color #f005
            font-family "Rodchenko Grotesk"
            text-align right
            padding-right: 1rem;
        img
            //float left
            max-width 100%
            height 10rem
            margin 0 auto 1rem
        @media screen and (min-width: 576px)
            .custom_btn
                width max-content
                justify-self flex-end
        @media screen and (min-width: 768px)
            grid-template-columns repeat(2, 1fr)
            .home_design_top
                grid-column-end span 2
        @media screen and (min-width: 1200px)
            grid-column 2 / 4

    .section_0_4
        .home_issue
            display grid
            margin-bottom 2rem
            gap 1rem
            img
                width 100%
        .custom_btn
            width 100%
            justify-content center
        @media screen and (min-width: 576px)
            display grid
            grid-template-columns repeat(2, auto)
            gap 2rem
            h2
                grid-column-end span 2
        @media screen and (min-width: 1200px)
            grid-column-start 1
            grid-row-start 3
            grid-row-end span 2
            grid-template-columns auto
            h2
                grid-column-end span 1
    .section_0_5
        margin 0
        padding 1rem 0
        display grid
        grid-template-rows auto 1fr
        @media screen and (min-width: 1200px)
            grid-column-start 2
            grid-column-end span 2
            grid-row-start 4
    .content main section.section_1_1
    .content main section.section_2_1
    .content main section.section_3_1
        display none
    .content section
        &.section_1_1
        &.section_2_1
        &.section_3_1
            grid-template-columns 1fr
            column-count 1
            padding 3rem 0
            display grid
            grid-template-rows auto auto 1fr
            gap 1rem 2rem
            align-content flex-start
            align-items flex-start
            .caption
                margin 2rem 0
                text-align left
            h1:not(.caption)
                font-family "Rodchenko Grotesk"
                color #D4AF37
                text-align right
            figure
                width 100%
                figcaption
                    transform translate(0, 70%)
                    font-size .5rem
            p:not(.caption)
                margin 0
            @media screen and (min-width: 400px)
                p:not(.caption)
                    column-count 2
                    column-gap 1.5rem
                figure
                    figcaption
                        font-size 1rem
            @media screen and (min-width: 576px)
                figure
                    figcaption
                        transform translate(0, 0)
                        font-size 1rem
            @media screen and (min-width: 1200px)
                grid-template-columns 1fr 2fr
                .caption
                    grid-column-end span 2
                h1:not(.caption)
                    grid-column-start 2
                figure
                    grid-column-start 1
                    grid-row-start 2
                    grid-row-end span 5
                    figcaption
                        transform translate(0, 100%)
                p:not(.caption)
                    grid-row-start auto
                    column-count 2
                    column-gap 2rem
        &.section_1_1
            grid-template-rows auto auto auto 1fr
            @media screen and (min-width: 1200px)
                figure
                    grid-column-start 2
                    grid-row-start 3
                    grid-row-end span 2
                p:not(.caption)
                    grid-row-start 4
        &.section_1_1
            grid-template-rows auto auto auto 1fr
            //figure
            //    figcaption
            //        font-size .5rem
            @media screen and (min-width: 1200px)
                figure
                    grid-column-start 1
                    grid-row-start 3
                p:not(.caption)
                    grid-row-start 4
                    grid-column-start 2
