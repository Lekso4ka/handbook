@import "./variables.styl"

.gzhel
    aside
        gap 2rem
        h2
            margin 0
    .meta_block
        display grid
        gap 1rem
        grid-template-rows auto auto 1fr
    .map_block
        display grid
        gqp 1rem
        grid-template-rows auto 1fr
        .map-container
            height 100%
    @media screen and (min-width: 1200px)
        aside
            position fixed
            height calc(100vh - 48px * 2)
            right calc(50vw - 550px)
            width calc(1100px / 5 * 2 - 2rem)
            display grid
            grid-template-rows 1fr 1fr

        article
            height 100%

    #map
        border-radius 50%
        img
            padding 0
            border-radius 0
    .meta-names
        display flex;
        justify-content: center;
        gap .5rem
        li
            cursor pointer
            text-align center
            padding 2px 6px
            border-radius .4rem
            color gz-primary
            &.active
                color gz-white
                background-color gz-secondary-50
    .meta-content
        //display none
        //padding 1rem 0
        height 100%

        & > div
            //gap 1rem
            //flex-wrap wrap
            max-height 100%
            overflow auto
            align-content flex-start
            align-items flex-start
            column-count 2
            column-gap 2rem
            &.active
                display grid
    .meta-line
        //grid-template-columns 1fr auto
        //display grid
        //gap .2rem
        //flex-grow: 1
    .meta-text
        //min-width max-content
        //display flex
        //border 1px solid
        justify-content: center;
        align-items stretch
        .link
            cursor pointer
            display flex
            align-items center
            flex 1
            padding 0 1rem
    .sup-content
        display flex
        align-items stretch
        gap .2rem
        flex-wrap wrap
        .sup
            cursor pointer
            display flex
            justify-content: center;
            align-items: center;
            padding 5px
            line-height 1
            flex 1
            border 1px solid
            background-color #d4af3780;
            &:hover
                background-color #d4af37
    .marker
        width 40px
        height 40px
        border 2px solid gz-secondary
        border-radius 50%
        background-color gz-secondary-10
        cursor pointer
    [data-type]
        &.show
            text-decoration underline
            color gz-secondary
            &.active
                background-color gz-secondary-10