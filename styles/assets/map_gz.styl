@import "./variables.styl"

.gzhel
    .marker
        width 40px
        height 40px
        border 2px solid gz-secondary
        border-radius 50%
        background-color gz-secondary-10
        cursor pointer
    .map_block
        display grid
        gqp 1rem
        grid-template-rows auto 1fr
    .map_container
        padding 1rem
        position relative
        &::after
            content ""
            background-image url("./img/ghzel/map_hor.png")
            background-position center
            background-size cover
            position absolute
            background-repeat no-repeat
            top 0
            left 0
            right 0
            bottom 0
            z-index 8
            pointer-events none
    #map
        height 100%
        width 100%
        clip-path: ellipse(50% 50% at center);
        border-radius 50%
        img
            padding 0
            border-radius 0

    .leaflet-control
        display none
    .leaflet-popup
        font-family Balkara, serif
    .leaflet-popup-content-wrapper
        box-shadow: 0 3px 14px rgba(gz-secondary-50);
    .leaflet-container a.leaflet-popup-close-button
        color gz-secondary
    .popup
        display grid
        gap 1rem
    .popup_main
        padding 1rem 0
        background-image url("./img/ghzel/foot-bord.png")
        background-size auto .6rem
        background-position center bottom
        background-repeat repeat-x
        display flex
        gap 1rem
        justify-content space-between
        align-items center
        h2
            font-family "A la russ", serif
            font-size 20px
            margin: 0
        .custom_btn
            padding .2rem .6rem
            margin 0
    .popup_art
        h3
            font-family "A la russ", serif
            font-size 16px
            text-align left
            margin 0
            color gz-text
        ul
            padding-left 1rem
            list-style-type disc
        li
            color gz-primary
            margin-bottom .2rem
            a
                color gz-secondary
                &:hover
                    text-decoration underline