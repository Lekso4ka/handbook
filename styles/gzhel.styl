@import "./assets/header_gz.styl";
@import "./assets/footer_gz.styl";

@import "./assets/sections_gz.styl";
@import "./assets/meta_gz.styl";
@import "./assets/map_gz.styl";

.gzhel
    font-family Balkara, serif
    color #636060
    ::-webkit-scrollbar-thumb
        background-color: gz-secondary-10;
    .wrapper
        padding 0 24px
        @media screen and (min-width: 1200px)
            padding 0 calc(50vw - 550px)
    .custom_btn
        border-radius 50px
        border 2px solid #3b40d9
        color #3b40d9
        cursor pointer
        display flex
        align-items center
        padding .4rem 1rem
        width max-content
        margin 0 auto
        &:disabled
            cursor auto
            //opacity .4
    h2
        color #003399
        text-shadow 1px 1px 3px #0516536d
        text-align center
        margin-bottom 1em
        margin-top 3rem
        font-size 32px
    h3
        color #003399
        font-size 20px
        margin-bottom 1em
        text-align center
    p
        text-align justify
        hyphens auto
        margin-bottom 1em
        font-size 16px
        &:not(.no-letter)::first-letter
            font-size: 300%;
            line-height: 1rem;
            float: left;
            margin-right: 0.15rem;
            margin-top: 0.1rem;
            padding-right: 0;
            text-transform uppercase
            color #003399
    .content
        padding 2rem 0
        display grid
        gap 2rem
        position relative
        @media screen and (min-width: 1200px)
            grid-template-columns 3fr 2fr
            height 100vh
            main
                height 100%
                overflow auto
                padding-right 8px

        .caption
            font-family "A la russ", serif
            font-size 5vw
            //white-space nowrap
            text-align center
            padding 300px 0 0
            position relative
            letter-spacing 0.02rem
            line-height 1.05
            color #003399
            margin 0
            &::before
                content ""
                height 300px
                width 100%
                position absolute
                top 0
                left 0
                background-image url(./img/ghzel/top_art.png)
                background-position center
                background-size contain
                background-repeat no-repeat
        .caption_3
            letter-spacing 0.005rem
        h1:not(.caption)
            font-size 1.5vw
            max-width 80%
            letter-spacing 0.15rem
            color #3439c0
            text-align center
            margin 0 auto
        main ul
            display grid
            line-height 1.3
            justify-items center
            text-align center
            color #434141
            margin 1.5rem 0 2rem
            li:last-child
                text-decoration underline
                cursor pointer
                color #003399
                &:hover
                    color #0055cc
        img, video
            border 2px solid #2d2c2c
            border-radius 100px 20px 90px 25px / 20px 80px 30px 100px
            max-width 100%
            padding 0.2rem

        figcaption
            font-size 0.75rem
            color #4341418c
            font-family 'Balkara', serif
            line-height 1.4
            text-align justify
            padding calc(2px + 0.2rem)
            margin-bottom 1rem
        .letter
            position relative
            &::first-letter
                font-size 0
            &.letter_o::before
                height calc(4em * 1.5)
                width calc(4em * 1.5 / 1.18)
                float left
                content ""
                background-image url(./img/ghzel/letters/O.png)
                background-repeat no-repeat
                background-size contain
            &.letter_d::before
                height calc(4em * 1.5)
                width calc(4em * 1.5 / 1.18)
                float left
                content ""
                background-image url(./img/ghzel/letters/D.png)
                background-repeat no-repeat
                background-size contain
                margin-right 4px
            &.letter_s::before
                height calc(4em * 1.5)
                width calc(4em * 1.5 / 1.18)
                float left
                vertical-align baseline
                content ""
                background-image url(./img/ghzel/letters/S.png)
                background-repeat no-repeat
                background-size contain
                margin-right 4px

        .p2_2
            float left
            margin-right 1rem
            figcaption
                display none
        .p1_2
            width 60%
            float right
            margin-left 1rem
        .p1_4
            float left
            width 50%
            margin-right 1rem
        .p1_6
            float right
            width 36%
            margin-left 1rem
            //figcaption
            //    display none
        .finish
            width 100%
            text-align center
        .finish_left
            display inline-block
            float left
            width 30vw
            height calc(5rem * 1.5)
            shape-outside polygon(0% 20%, 100% 100%, 0 100%)
        .finish_right
            display inline-block
            float right
            width 30vw
            height calc(5rem * 1.5)
            shape-outside polygon(100% 20%, 0% 100%, 100% 100%)
        .finish_2
            .finish_left
            .finish_right
                width 30%
                height calc(17rem * 1.5)
                @media screen and (min-width: 360px)
                    width 32%
                    height calc(13rem * 1.5)
                @media screen and (min-width: 400px)
                    height calc(11rem * 1.5)
                @media screen and (min-width: 450px)
                    height calc(10rem * 1.5)
                @media screen and (min-width: 480px)
                    width 32%
                    height calc(9rem * 1.5)
                @media screen and (min-width: 520px)
                    width 30%
                    height calc(8rem * 1.5)
                @media screen and (min-width: 600px)
                    width 32%
                    height calc(7rem * 1.5)
                @media screen and (min-width: 700px)
                    height calc(6rem * 1.5)
                @media screen and (min-width: 800px)
                    width 30%
                    height calc(5rem * 1.5)
                @media screen and (min-width: 850px)
                    width 35%
                    height calc(5rem * 1.5)
                @media screen and (min-width: 900px)
                    width 30%
                @media screen and (min-width: 1000px)
                    width 32%
                    height calc(4rem * 1.5)
                @media screen and (min-width: 1200px)
                    width 32%
                    height calc(7rem * 1.5)
        .finish_3
            .finish_left
            .finish_right
                width 35%
                height calc(15rem * 1.5)
                @media screen and (min-width: 360px)
                    width 32%
                    height calc(13rem * 1.5)
                @media screen and (min-width: 400px)
                    height calc(11rem * 1.5)
                @media screen and (min-width: 450px)
                    height calc(10rem * 1.5)
                @media screen and (min-width: 480px)
                    width 32%
                    height calc(9rem * 1.5)
                @media screen and (min-width: 520px)
                    width 30%
                    height calc(8rem * 1.5)
                @media screen and (min-width: 600px)
                    width 32%
                    height calc(7rem * 1.5)
                @media screen and (min-width: 700px)
                    height calc(6rem * 1.5)
                @media screen and (min-width: 800px)
                    width 30%
                    height calc(5rem * 1.5)
                @media screen and (min-width: 850px)
                    width 35%
                    height calc(5rem * 1.5)
                @media screen and (min-width: 900px)
                    width 30%
                @media screen and (min-width: 1000px)
                    width 32%
                    height calc(4rem * 1.5)
                @media screen and (min-width: 1200px)
                    width 32%
                    height calc(7rem * 1.5)
    .popup_container
        position fixed
        background-color gz-white-50
        backdrop-filter blur(2px)
        top 0
        left 0
        right 0
        bottom 0
        z-index 10
        padding 2rem
        display none
        justify-content: center;
        align-items: center;
        &.active
            display flex
        .popup
            box-sizing border-box
            border-radius 3rem
            border 2px solid gz-primary
            padding 2rem
            position relative
            background-color gz-white
            h2
                margin .5rem 0 .2rem
                font-size: 1rem;
            p
                font-size .4rem
            .popup_close
                outline none
                box-shadow none
                border 1px solid transparent
                padding .1rem .2rem
                border-radius .3rem
                display flex
                align-items center
                justify-content center
                height 36px
                width 36px
                top 0
                right 1rem
                position absolute
                svg
                    fill gz-primary
                    height 28px
                    width 28px
            ul
                //margin-bottom 1rem;
                li
                    display grid
                    grid-template-columns auto 1fr
                    gap 1rem
                    margin-bottom 1rem
                    font-size .4rem
                    span
                        color gz-secondary
                a
                    text-wrap wrap
                    color gz-secondary-50
                    &:hover
                        color gz-secondary

        @media screen and (min-width: 768px)
            .popup
                p
                ul li
                    font-size .6rem
        @media screen and (min-width: 1200px)
            .popup
                min-width 60%
                max-width 80%
                .popup_close
                    position absolute
                h2
                    font-size: 2rem;
                p
                ul li
                    font-size 1rem
    .docs
        h1
            h1
            font-family "A la russ", serif
            text-transform uppercase
            justify-self center
            font-size 5rem
            text-align center
            position relative
            z-index 1
            color gz-primary
        h2
            color gz-secondary
        img
            width 100%
            margin-bottom 1rem
            border 2px solid #2d2c2c
            border-radius 100px 20px 90px 25px / 20px 80px 30px 100px
            max-width 100%
            padding 0.2rem
        ul
            margin-bottom 2rem
            padding-left 2rem
        article
            margin-bottom 2rem
        @media screen and (min-width: 576px)
            .p_docs_1
                width 300px
                float left
                margin-right 1rem
            .p_docs_4
                width 200px
                float right
                margin-left 1rem
    .mark {
        position fixed
        width max-content
        top 1rem
        padding 0 2.5rem 4rem 2rem
        display grid
        color gz-secondary
        background-color gz-white-50
        background-image url("./img/ghzel/mark.png")
        background-size contain
        background-position bottom center
        background-repeat no-repeat
        box-sizing content-box
        z-index 1
        border-radius 20px 20px 90px 25px / 20px 80px 30px 100px
    }
